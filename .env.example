# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Every credential here belongs to an account with no connection to any other
# identity, organisation or company. That is a hard constraint, not a
# preference — see docs/ISOLATION.md before adding anything to this file.


# --- Research resolver -------------------------------------------------------
# Only the `research` source needs these. The reflector, open-meteo and
# contrarian sources run without any of it.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model that supports structured outputs. Left unset it defaults
# to google/gemini-3.7-flash — cheap, current, and good enough to search with.
# The model that answered is recorded in the evidence document either way.
# OPENROUTER_MODEL=google/gemini-3.7-flash

# Per-attempt timeout and attempt count. Two attempts at 70s plus backoff still
# fit inside the contract's 300s resolve window. Raise the timeout only if you
# also check that budget. Only transient failures retry; a 401 fails at once.
# OPENROUTER_TIMEOUT_MS=70000
# OPENROUTER_ATTEMPTS=2


# --- Agent identity ----------------------------------------------------------
# Usually passed on the command line instead, so a secret never sits in a file:
#   AGENT_SECRET_KEY=$(stellar keys show bot-honest) AGENT_ID=21 pnpm -s resolve

# AGENT_SECRET_KEY=
# AGENT_ID=
# RESOLUTION_SOURCE=reflector


# --- Curator -----------------------------------------------------------------
# Opening markets. Same rule: prefer the command line.

# CURATOR_SECRET_KEY=
